{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "tx-bootstrap participant values",
  "type": "object",
  "required": [
    "logLevel",
    "identity",
    "publicEndpoints",
    "vault",
    "existingSecret",
    "jobs",
    "identityHub",
    "participantInit",
    "controlPlane",
    "dataPlane",
    "federatedCatalog",
    "portal",
    "publicGateway",
    "internalGateway",
    "ingress"
  ],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "logLevel": { "type": "string", "minLength": 1 },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "javaRuntime": {
      "type": "object",
      "required": [
        "javaToolOptions",
        "otelSdkDisabled",
        "otelJavaagentEnabled"
      ],
      "properties": {
        "javaToolOptions": { "type": "string", "minLength": 1 },
        "otelSdkDisabled": { "type": "boolean" },
        "otelJavaagentEnabled": { "type": "boolean" }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "participantRole",
        "participantBpn",
        "participantBpnBase64",
        "participantContextId",
        "identityHubParticipantContextId",
        "participantDidHost",
        "participantPublicHost",
        "issuerBpn",
        "issuerDidHost",
        "useHttpsDidWeb"
      ],
      "properties": {
        "participantRole": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        },
        "participantBpn": { "$ref": "#/definitions/bpn" },
        "participantBpnBase64": { "$ref": "#/definitions/base64" },
        "participantContextId": { "type": "string", "format": "uuid" },
        "identityHubParticipantContextId": { "type": "string", "minLength": 1 },
        "participantDidHost": { "$ref": "#/definitions/hostname" },
        "participantPublicHost": { "$ref": "#/definitions/hostname" },
        "issuerBpn": { "$ref": "#/definitions/bpn" },
        "issuerDidHost": { "$ref": "#/definitions/hostname" },
        "useHttpsDidWeb": { "type": "boolean" }
      }
    },
    "publicEndpoints": {
      "type": "object",
      "required": [
        "dspCallbackAddress",
        "credentialServiceEndpoint",
        "dataPlaneBaseUrl",
        "dataPlaneTokenRefreshEndpoint",
        "bdrsServerUrl"
      ],
      "properties": {
        "dspCallbackAddress": { "$ref": "#/definitions/optionalUrl" },
        "credentialServiceEndpoint": { "$ref": "#/definitions/optionalUrl" },
        "dataPlaneBaseUrl": { "$ref": "#/definitions/optionalUrl" },
        "dataPlaneTokenRefreshEndpoint": {
          "$ref": "#/definitions/optionalUrl"
        },
        "bdrsServerUrl": { "$ref": "#/definitions/url" }
      }
    },
    "vault": {
      "type": "object",
      "required": ["url", "apiSecretPath", "healthCheckPath"],
      "properties": {
        "url": { "$ref": "#/definitions/url" },
        "apiSecretPath": { "type": "string", "pattern": "^/" },
        "healthCheckPath": { "type": "string", "pattern": "^/" }
      }
    },
    "existingSecret": {
      "type": "object",
      "required": ["name", "keys"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "keys": {
          "type": "object",
          "required": [
            "vaultToken",
            "identityHubSuperuserApiKey",
            "identityHubJdbcUrl",
            "identityHubDbUser",
            "identityHubDbPassword",
            "edcJdbcUrl",
            "edcDbUser",
            "edcDbPassword",
            "portalMigratorDatabaseUrl",
            "portalDatabaseUrl",
            "edcApiKey",
            "federatedCatalogApiKey",
            "identityHubApiKey",
            "onboardingRegistrationToken"
          ],
          "properties": {
            "vaultToken": { "$ref": "#/definitions/secretKey" },
            "identityHubSuperuserApiKey": { "$ref": "#/definitions/secretKey" },
            "identityHubJdbcUrl": { "$ref": "#/definitions/secretKey" },
            "identityHubDbUser": { "$ref": "#/definitions/secretKey" },
            "identityHubDbPassword": { "$ref": "#/definitions/secretKey" },
            "edcJdbcUrl": { "$ref": "#/definitions/secretKey" },
            "edcDbUser": { "$ref": "#/definitions/secretKey" },
            "edcDbPassword": { "$ref": "#/definitions/secretKey" },
            "portalMigratorDatabaseUrl": { "$ref": "#/definitions/secretKey" },
            "portalDatabaseUrl": { "$ref": "#/definitions/secretKey" },
            "edcApiKey": { "$ref": "#/definitions/secretKey" },
            "federatedCatalogApiKey": { "$ref": "#/definitions/secretKey" },
            "identityHubApiKey": { "type": "string" },
            "onboardingRegistrationToken": { "type": "string" }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "required": [
        "portalMigrator",
        "participantInit",
        "retryTimeoutMs",
        "retryDelayMs",
        "resources"
      ],
      "properties": {
        "portalMigrator": {
          "allOf": [
            { "$ref": "#/definitions/job" },
            {
              "type": "object",
              "required": [
                "serviceAccountName",
                "migrationDirectory",
                "ownerRole",
                "runtimeRole"
              ],
              "properties": {
                "serviceAccountName": { "type": "string", "minLength": 1 },
                "migrationDirectory": { "type": "string", "pattern": "^/" },
                "ownerRole": { "type": "string", "minLength": 1 },
                "runtimeRole": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "participantInit": { "$ref": "#/definitions/job" },
        "retryTimeoutMs": { "type": "integer", "minimum": 1000 },
        "retryDelayMs": { "type": "integer", "minimum": 100 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "identityHub": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "required": [
            "jtiValidation",
            "encryptionKeyAlias",
            "encryptionStrict"
          ],
          "properties": {
            "jtiValidation": { "type": "boolean" },
            "encryptionKeyAlias": { "type": "string", "minLength": 1 },
            "encryptionStrict": { "type": "boolean" }
          }
        }
      ]
    },
    "participantInit": {
      "type": "object",
      "required": ["securityContext", "image", "superuserApiKeyAlias"],
      "properties": {
        "securityContext": { "$ref": "#/definitions/runtimeIdentity" },
        "image": { "$ref": "#/definitions/firstPartyImage" },
        "superuserApiKeyAlias": { "type": "string", "minLength": 1 }
      }
    },
    "controlPlane": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "required": [
            "bdrsCacheValiditySeconds",
            "trustedIssuerSupportedTypes"
          ],
          "properties": {
            "bdrsCacheValiditySeconds": { "type": "integer", "minimum": 1 },
            "trustedIssuerSupportedTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "dataPlane": { "$ref": "#/definitions/component" },
    "federatedCatalog": {
      "allOf": [
        { "$ref": "#/definitions/firstPartyHttpComponent" },
        {
          "type": "object",
          "required": [
            "directoryRefreshIntervalSeconds",
            "catalogRefreshIntervalSeconds",
            "crawlConcurrency",
            "persistence"
          ],
          "properties": {
            "image": { "$ref": "#/definitions/firstPartyImage" },
            "directoryRefreshIntervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "catalogRefreshIntervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "crawlConcurrency": { "type": "integer", "minimum": 1 },
            "persistence": {
              "type": "object",
              "required": ["storageClass", "size", "accessModes"],
              "properties": {
                "storageClass": { "type": "string" },
                "size": { "type": "string", "minLength": 1 },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "portal": {
      "allOf": [
        { "$ref": "#/definitions/firstPartyHttpComponent" },
        {
          "type": "object",
          "required": [
            "title",
            "name",
            "upstreamTimeoutMs",
            "dataProxy",
            "httpsHeaders",
            "rateLimit",
            "auth",
            "onboarding"
          ],
          "properties": {
            "image": { "$ref": "#/definitions/firstPartyImage" },
            "title": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "upstreamTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "dataProxy": {
              "type": "object",
              "required": [
                "timeoutMs",
                "maxRequestBytes",
                "allowedPrivateHosts"
              ],
              "properties": {
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxRequestBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "allowedPrivateHosts": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/definitions/hostname" }
                }
              }
            },
            "httpsHeaders": { "type": "boolean" },
            "rateLimit": {
              "type": "object",
              "required": ["enabled", "max", "window"],
              "properties": {
                "enabled": { "type": "boolean" },
                "max": { "type": "integer", "minimum": 1 },
                "window": { "type": "string", "minLength": 1 }
              }
            },
            "auth": {
              "type": "object",
              "required": ["mode", "header", "allowedUsers", "allowInsecure"],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["none", "forwarded-header"]
                },
                "header": { "type": "string", "minLength": 1 },
                "allowedUsers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "allowInsecure": { "type": "boolean" }
              }
            },
            "onboarding": {
              "type": "object",
              "required": [
                "dataspaceAdminApiUrl",
                "organizationName",
                "requestedBpn",
                "contactEmail",
                "requestedRole",
                "did",
                "dspEndpoint",
                "credentialServiceEndpoint"
              ],
              "properties": {
                "dataspaceAdminApiUrl": { "$ref": "#/definitions/url" },
                "organizationName": { "type": "string" },
                "requestedBpn": { "type": "string" },
                "contactEmail": { "type": "string" },
                "requestedRole": { "type": "string", "minLength": 1 },
                "did": { "type": "string" },
                "dspEndpoint": { "$ref": "#/definitions/optionalUrl" },
                "credentialServiceEndpoint": {
                  "$ref": "#/definitions/optionalUrl"
                }
              }
            }
          }
        }
      ]
    },
    "publicGateway": { "$ref": "#/definitions/httpComponent" },
    "internalGateway": { "$ref": "#/definitions/httpComponent" },
    "ingress": {
      "type": "object",
      "required": ["public", "internal"],
      "properties": {
        "public": { "$ref": "#/definitions/ingress" },
        "internal": { "$ref": "#/definitions/ingress" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "portal": {
            "properties": {
              "auth": {
                "properties": { "mode": { "const": "none" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "portal": {
            "properties": {
              "auth": {
                "properties": { "allowInsecure": { "const": true } }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "bpn": { "type": "string", "pattern": "^BPN[LSA][A-Z0-9]{12}$" },
    "base64": { "type": "string", "pattern": "^[A-Za-z0-9_-]+={0,2}$" },
    "hostname": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
    },
    "url": { "type": "string", "pattern": "^https?://" },
    "optionalUrl": { "type": "string", "pattern": "^$|^https?://.+$" },
    "secretKey": { "type": "string", "minLength": 1 },
    "imageShape": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "image": {
      "allOf": [
        { "$ref": "#/definitions/imageShape" },
        { "properties": { "tag": { "minLength": 1 } } }
      ]
    },
    "firstPartyImage": {
      "allOf": [
        { "$ref": "#/definitions/imageShape" },
        {
          "anyOf": [
            {
              "properties": {
                "digest": { "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            },
            {
              "properties": {
                "tag": {
                  "not": { "enum": ["latest", "main", "master"] }
                }
              }
            }
          ]
        }
      ]
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "replicaCount",
        "securityContext",
        "image",
        "service",
        "resources"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "securityContext": { "$ref": "#/definitions/runtimeIdentity" },
        "image": { "$ref": "#/definitions/image" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "required": ["runAsUser", "runAsGroup"],
      "properties": {
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 }
      }
    },
    "httpComponent": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "properties": {
            "service": {
              "allOf": [
                { "$ref": "#/definitions/service" },
                { "type": "object", "required": ["port"] }
              ]
            }
          }
        }
      ]
    },
    "firstPartyHttpComponent": {
      "type": "object",
      "required": [
        "replicaCount",
        "securityContext",
        "image",
        "service",
        "resources"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "securityContext": { "$ref": "#/definitions/runtimeIdentity" },
        "image": { "$ref": "#/definitions/firstPartyImage" },
        "service": {
          "allOf": [
            { "$ref": "#/definitions/service" },
            { "type": "object", "required": ["port"] }
          ]
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "job": {
      "type": "object",
      "required": ["enabled", "backoffLimit", "activeDeadlineSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "path",
        "pathType",
        "tls"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/hostname" }
        },
        "path": { "type": "string", "pattern": "^/" },
        "pathType": {
          "type": "string",
          "enum": ["Exact", "Prefix", "ImplementationSpecific"]
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hosts", "secretName"],
            "properties": {
              "hosts": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "secretName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
