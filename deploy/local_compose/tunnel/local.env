# Local tunnel values (no public DNS, no certificates). The local stack uses
# did:web over plain HTTP, so Headscale and the ingress serve HTTP on the
# shared network.
COMPOSE_PROJECT_NAME=tx-bootstrap-tunnel
TUNNEL_HEADSCALE_URL=http://headscale.tunnel.test
TUNNEL_DOMAIN=tunnel.test
# ACME is disabled by local.override.yml; these only satisfy interpolation.
TUNNEL_ACME_EMAIL=local@example.org
TUNNEL_ACME_DNS_PROVIDER=hetzner
