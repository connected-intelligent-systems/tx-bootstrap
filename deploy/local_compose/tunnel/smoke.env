# Local smoke test of deploy/compose/tunnel.compose.yaml with the throwaway
# Headscale from headscale.compose.yaml, without public DNS. Headscale is
# reached inside Docker over HTTP. TLS uses Traefik's default certificate
# because ACME cannot complete for the .test zone.
COMPOSE_PROJECT_NAME=txb-tunnel-smoke
TUNNEL_HEADSCALE_URL=http://headscale:8080
TUNNEL_DOMAIN=tunnel.test
TUNNEL_ACME_EMAIL=smoke@example.org
TUNNEL_ACME_DNS_PROVIDER=hetzner
TUNNEL_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TUNNEL_HTTP_PORT=28080
TUNNEL_HTTPS_PORT=28443
# No DNS provider credentials: ACME cannot complete for .test anyway.
TUNNEL_ACME_ENV_FILE=/dev/null
