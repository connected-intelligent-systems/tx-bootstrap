# Local-only convenience env for scripts that coordinate all three roles.
# Role compose files can also be run with their own deployment/<role>/.env.example.

COMPOSE_PROJECT_PREFIX=tx-bootstrap
TX_BOOTSTRAP_PUBLIC_NETWORK=tx-bootstrap-public
OPERATOR_EDGE_NETWORK=tx-bootstrap-public
OPERATOR_EDGE_NETWORK_EXTERNAL=true
PARTICIPANT_PUBLIC_NETWORK=tx-bootstrap-public
PARTICIPANT_PUBLIC_NETWORK_EXTERNAL=true

# One PostgreSQL instance serves all local roles through three private networks.
# Database and login names remain unique per operator/provider/consumer env.

BPN_ISSUER=BPNL00000003CRHK
BPN_PROVIDER=BPNL00000003AYRE
BPN_CONSUMER=BPNL00000003AZQP
BPN_ISSUER_BASE64=QlBOTDAwMDAwMDAzQ1JISw==
BPN_PROVIDER_BASE64=QlBOTDAwMDAwMDAzQVlSRQ==
BPN_CONSUMER_BASE64=QlBOTDAwMDAwMDAzQVpRUA==
PROVIDER_PARTICIPANT_CONTEXT_ID=596b0330-76ec-5c8e-af01-24ba6a21d4e6
CONSUMER_PARTICIPANT_CONTEXT_ID=1c75df57-20d9-537e-aa45-7d5ec1b342b6

ISSUER_DID_HOST=issuer-did
PROVIDER_DID_HOST=provider-did
CONSUMER_DID_HOST=consumer-did

IDENTITYHUB_TAG=0.3.2
BDRS_TAG=0.5.7
TRACTUSX_EDC_TAG=0.12.1
ISSUERSERVICE_TAG=0.3.2
# Local development uses the in-repo operator and participant components and locally built helper images.
OPERATOR_COMPOSE_REF=../../compose/operator.compose.yaml
PARTICIPANT_COMPOSE_REF=../../compose/participant.compose.yaml
OPERATOR_CONSOLE_IMAGE=tx-bootstrap-operator-console:local
OPERATOR_ONBOARDING_SERVICE_IMAGE=tx-bootstrap-operator-onboarding-service:local
PARTICIPANT_INIT_IMAGE=tx-bootstrap-participant-init:local
PARTICIPANT_PORTAL_BACKEND_IMAGE=tx-bootstrap-participant-portal-backend:local
FEDERATED_CATALOG_IMAGE=tx-bootstrap-federated-catalog:local

# Keep local development endpoints on loopback. Override these explicitly when
# another host must reach the demo and enable authentication for admin routes.
OPERATOR_HTTP_BIND=127.0.0.1
ISSUER_PUBLIC_HTTP_BIND=127.0.0.1
PUBLIC_HTTP_BIND=127.0.0.1
INTERNAL_HTTP_BIND=127.0.0.1
LOCAL_URL_HOST=localhost

POSTGRES_USER=user
POSTGRES_PASSWORD=password
BDRS_DB_USER=bdrs
BDRS_DB_PASSWORD=bdrspassword
OPERATOR_MIGRATOR_DB_PASSWORD=operator_migrator_password
OPERATOR_CONSOLE_DB_PASSWORD=operator_console_password
REGISTRATION_DB_PASSWORD=registration_svc_password
ISSUER_IDENTITYHUB_JTI_VALIDATION=true
ISSUER_IDENTITYHUB_ENCRYPTION_KEY_ALIAS=issuer-identityhub-encryption-key
ISSUER_IDENTITYHUB_ENCRYPTION_STRICT=true
ISSUER_SERVICE_JTI_VALIDATION=true
ISSUER_SERVICE_ENCRYPTION_KEY_ALIAS=issuer-service-encryption-key
ISSUER_SERVICE_ENCRYPTION_STRICT=true
PARTICIPANT_IDENTITYHUB_JTI_VALIDATION=true
PARTICIPANT_IDENTITYHUB_ENCRYPTION_KEY_ALIAS=participant-identityhub-encryption-key
PARTICIPANT_IDENTITYHUB_ENCRYPTION_STRICT=true

VAULT_URL=http://vault:8200
VAULT_TOKEN=local-dev-token
EDC_API_KEY=password
FEDERATED_CATALOG_API_KEY=local-federated-catalog-key
DIRECTORY_REFRESH_INTERVAL_SECONDS=5
CATALOG_REFRESH_INTERVAL_SECONDS=10
PROVIDER_IDENTITYHUB_API_KEY=
CONSUMER_IDENTITYHUB_API_KEY=
IDENTITYHUB_SUPERUSER_API_KEY=c3VwZXItdXNlcg==.local-dev-super-user-key
BDRS_API_KEY=password
ISSUER_API_KEY=
BDRS_MANAGEMENT_HOST_PORT=39081
OPERATOR_CONSOLE_HOST_PORT=39080
OPERATOR_ONBOARDING_SERVICE_HOST_PORT=39085
PROVIDER_PUBLIC_HTTP_HOST_PORT=29284
PROVIDER_INTERNAL_HTTP_HOST_PORT=29283
PROVIDER_API_HTTP_HOST_PORT=29282
CONSUMER_PUBLIC_HTTP_HOST_PORT=19284
CONSUMER_INTERNAL_HTTP_HOST_PORT=19283
CONSUMER_API_HTTP_HOST_PORT=19282

# Local-only portal administrator. Nginx receives only the htpasswd entry; the
# plaintext value is used by the bootstrap/E2E helpers for scripted access.
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=local-admin-password
PORTAL_BASIC_AUTH_USERS='admin:$2y$05$Uo81a8kU1WarNs5lPlTiSu87kPFwgnbtStsqXv4Pq/CYlLT7vkEt.'
OPERATOR_CONSOLE_AUTH_MODE=network
OPERATOR_CONSOLE_HTTPS_HEADERS=false
PARTICIPANT_PORTAL_HTTPS_HEADERS=false
PARTICIPANT_PORTAL_PREVIEW_ALLOWED_PRIVATE_HOSTS=provider-did,consumer-did
OPERATOR_ONBOARDING_SERVICE_ALLOWED_ORIGINS=*
# Set OPERATOR_CONSOLE_AUTH_MODE=api-key and OPERATOR_CONSOLE_API_KEY=... to protect admin endpoints for scripted access.
# Optional operator-console branding overrides:
# OPERATOR_CONSOLE_TITLE=Participant Operations
# OPERATOR_CONSOLE_SUBTITLE=Dataspace Administration

JAVA_TOOL_OPTIONS=-Xmx256m
OTEL_SDK_DISABLED=true
OTEL_JAVAAGENT_ENABLED=false
PROVIDER_DEMO_ASSET_URL=https://jsonplaceholder.typicode.com/todos/1
