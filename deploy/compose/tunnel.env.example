# Settings for tunnel.compose.yaml. Copy next to the compose file as .env and
# fill in; each operator deployment uses its own domain and wildcard
# certificate. See docs/participant-tunnel.md#deploy. Relative paths resolve
# against the compose project directory.
COMPOSE_PROJECT_NAME=txb-tunnel
# The operator's Headscale server (the same URL participants and the console use).
TUNNEL_HEADSCALE_URL=https://headscale.example.org
# Must match Headscale's dns.base_domain.
TUNNEL_MAGICDNS_DOMAIN=tailnet.internal
TUNNEL_DOMAIN=tunnel.example.org
# Public IPv4 and UDP 41641 of this server, for direct WireGuard connections.
TUNNEL_PUBLIC_ENDPOINT=203.0.113.10:41641
TUNNEL_ACME_EMAIL=ops@example.org
# Any Traefik/lego DNS provider; its credentials go in TUNNEL_ACME_ENV_FILE.
TUNNEL_ACME_DNS_PROVIDER=hetzner
TUNNEL_ACME_ENV_FILE=./secrets/acme.env
# tag:txb-ingress pre-auth key; only needed for the first start.
TUNNEL_INGRESS_AUTHKEY_FILE=./secrets/ingress-authkey
