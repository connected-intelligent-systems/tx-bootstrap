{
  "name": "tx-bootstrap",
  "private": true,
  "version": "0.1.6",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=12 <13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "bash scripts/verify.sh",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "build:core": "npm run build --workspace @tx-bootstrap/core",
    "build:operator-console": "npm run build --workspace @tx-bootstrap/operator-console",
    "build:operator-onboarding-service": "npm run build --workspace @tx-bootstrap/operator-onboarding-service",
    "build:ui-runtime": "npm run build --workspace @tx-bootstrap/ui-runtime",
    "build:participant-portal": "npm run build --workspace @tx-bootstrap/participant-portal",
    "lint:participant-portal": "npm run lint --workspace @tx-bootstrap/participant-portal",
    "test:participant-portal": "npm run test --workspace @tx-bootstrap/participant-portal",
    "type-check:participant-portal": "npm run type-check --workspace @tx-bootstrap/participant-portal",
    "prepare": "husky",
    "format:staged": "lint-staged"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "6.30.1",
    "react-router-dom": "6.30.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "~6.0.2"
  },
  "lint-staged": {
    "*.{css,html,js,jsx,json,jsonc,md,mdx,scss,ts,tsx,yaml,yml}": "prettier --write"
  }
}
