    "@triply/yasgui": "4.2.28",
    "@tx-bootstrap/ui-runtime": "0.0.0",
    "@types/jsonld": "1.5.15",
    "@types/lodash": "4.17.24",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
