{
  "name": "@tx-bootstrap/participant-portal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace @tx-bootstrap/core && npm run build --workspace @tx-bootstrap/ui-runtime && npm run build:portal && npm run build:server",
    "build:portal": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "migrate": "node dist-server/server/migrate.js",
    "start": "node dist-server/server/index.js",
    "serve": "vite preview",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "node scripts/generate-participant-openapi.mjs",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@thingweb/open-api-converter": "1.0.0",
