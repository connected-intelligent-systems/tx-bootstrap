{
  "name": "@tx-bootstrap/operator-onboarding-service",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run build --workspace @tx-bootstrap/core && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "node dist-server/apps/operator-onboarding-service/server/index.js",
    "test": "npm run build --workspace @tx-bootstrap/core && npm run build:server && vitest run"
  },
  "dependencies": {
    "@tx-bootstrap/core": "0.1.2",
    "@types/nodemailer": "^8.0.1",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.9"
  }
}
