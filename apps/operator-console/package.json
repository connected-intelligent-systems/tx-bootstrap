{
  "name": "@tx-bootstrap/operator-console",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace @tx-bootstrap/core && npm run build --workspace @tx-bootstrap/ui-runtime && npm run build:server && tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist-server/apps/operator-console/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "npm run build --workspace @tx-bootstrap/core && npm run build:server && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "node dist-server/apps/operator-console/server/migrate.js"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@tx-bootstrap/core": "0.1.5",
    "@types/nodemailer": "^8.0.1",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@tanstack/react-query": "^5.101.0",
    "@tx-bootstrap/ui-runtime": "0.1.5",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
