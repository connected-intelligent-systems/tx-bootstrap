{
  "name": "@tx-bootstrap/core",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.9"
  },
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./api/*.js": {
      "types": "./dist/api/*.d.ts",
      "default": "./dist/api/*.js"
    },
    "./server/*.js": {
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js"
    }
  },
  "files": [
    "dist",
    "db"
  ],
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
